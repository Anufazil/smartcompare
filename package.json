{
  "name": "smartcompare",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@smartcompare/web --filter=@smartcompare/api",
    "build": "turbo build",
    "test": "vitest run --configLoader native",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @smartcompare/api db:generate",
    "db:migrate": "pnpm --filter @smartcompare/api db:migrate",
    "db:seed": "pnpm --filter @smartcompare/api db:seed",
    "worker": "pnpm --filter @smartcompare/worker dev",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "test:integration": "pnpm --filter @smartcompare/api test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "supertest": "^7.2.0",
    "tsx": "^4.21.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.2.4",
    "esbuild": "^0.28.2"
  }
}

{
  "name": "@smartcompare/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && node ../../scripts/build-service.mjs api",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "tsx tests/integration.ts"
  },
  "dependencies": {
    "@smartcompare/live": "workspace:*",
    "@smartcompare/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.70.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "pino": "^9.14.0",
    "rate-limit-redis": "^4.3.1",
    "robots-parser": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

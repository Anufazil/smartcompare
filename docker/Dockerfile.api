FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/* && corepack enable
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @smartcompare/api build
ENV NODE_ENV=production API_HOST=0.0.0.0
USER node
EXPOSE 4000
CMD ["pnpm","--filter","@smartcompare/api","start"]
